{
    "name": "fun-chat",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "deploy": "npm run build && gh-pages -d public",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "check-format": "prettier --list-different --ignore-unknown . && npx prettier --write `src/**/*.scss`",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "eslint": "^9.39.2",
        "eslint-plugin-unicorn": "^57.0.0",
        "gh-pages": "^6.3.0",
        "prettier": "3.5.3",
        "sass": "^1.97.3",
        "ts-loader": "^9.5.4",
        "typescript": "~5.7.3",
        "vite": "^6.4.1",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-svgr": "^4.5.0",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "dependencies": {
        "normalize.css": "^8.0.1"
    }
}
